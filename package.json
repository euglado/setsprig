{
  "name": "setsprig",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual Discord setlist duration planner with private previews",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "lint": "biome check .",
    "test": "node --test test/*.test.mjs",
    "supply": "node scripts/supply.mjs",
    "check": "npm run lint && npm run build && npm test && npm run supply",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/launch.mjs main",
    "register": "node scripts/launch.mjs register"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
